# Rename to .env and fill real values. Do not commit secrets.

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL="https://wwstntrikjasjotnrnco.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Firebase Configuration (for Google Sign-In)
EXPO_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
EXPO_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Google OAuth Client ID (for Google Sign-In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# Database Connection (Transaction Pooler)
SUPABASE_DB_URL="postgres://postgres:YOUR_PASSWORD@db.wwstntrikjasjotnrnco.supabase.co:6543/postgres"

# OpenAI (for problem generation)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# Code Execution Provider (Optional - choose one)
JDOODLE_CLIENT_ID=""
JDOODLE_CLIENT_SECRET=""
SPHERE_ENGINE_TOKEN=""

# App Configuration
EXPO_PUBLIC_ENV="development"
RECALL_PLAN_DEFAULT="baseline"
EXPO_NO_ROUTER=1

# --- Agent orchestration ---
# Session-mode pooler (port 5432). The transaction pooler on 6543 silently
# drops LISTEN registrations, which breaks the outbox relay's wakeup.
SUPABASE_DB_URL_SESSION=postgresql://USER:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Backend (server/) — defaults shown, all optional
KAFKA_BROKERS=localhost:29092
TEMPORAL_ADDRESS=localhost:7233
# live | stub — stub returns a canned valid payload, which is what makes the
# throughput benchmarks free and independent of OpenAI's rate limit.
LLM_MODE=live
# Set to 1 to make the first generation return a schema-invalid payload,
# demonstrating the validate -> repair loop.
CHAOS_INVALID_PAYLOAD=0

# Client escape hatch: 1 restores the original blocking generation path.
EXPO_PUBLIC_USE_LEGACY_GENERATION=0
